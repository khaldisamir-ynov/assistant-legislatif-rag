# Copier ce fichier en .env puis remplir les valeurs. Ne JAMAIS commiter .env.

# Fournisseur LLM, via une API compatible OpenAI. Clé : https://console.mistral.ai
# Pour basculer plus tard :  Ollama : http://localhost:11434/v1  |  vLLM : http://localhost:8000/v1
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=ministral-14b-latest

# Variante Hugging Face (Academia Hub de l'école) : LLM_API_KEY = token HF (hf_...), https://huggingface.co/settings/tokens
# LLM_MODEL = id d'un modèle servi par les Inference Providers, suffixe ":fournisseur" facultatif
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_BILL_TO=6acf7e1c0be943d1f0ca6804   # facture le budget étudiant de l'école au lieu du compte perso
# LLM_REASONING_EFFORT=none   # modèles à raisonnement (Qwen3) : sinon la réflexion épuise MAX_TOKENS -> réponse vide

# Modèle d'embeddings local : le MÊME pour l'ingestion et pour les requêtes
# (e5-base n'est pas servi en vecteurs par Hugging Face ; e5-large, qui l'est, classe moins bien : 20/31 contre 29/31, 16/10/2026)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Le modèle d'embeddings est téléchargé une seule fois (1er lancement), puis lu sur le disque.
# Une fois téléchargé, HF_HUB_OFFLINE=1 évite toute connexion réseau au chargement.
# HF_HUB_OFFLINE=1

# Windows : masque l'avertissement "symlinks" du cache du modèle d'embeddings (inoffensif)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Suivi MLflow (app/suivi.py) : URL du serveur MLflow. Vide ou absent = suivi désactivé.
# Le serveur et son tableau de bord (http://localhost:5000) tournent dans leur propre conteneur
# (lancer depuis PowerShell : Git Bash réécrit "/mlflow/artifacts" en chemin Windows, sauf avec MSYS_NO_PATHCONV=1) :
#   docker run -d --name mlflow --restart unless-stopped -p 5000:5000 -v mlflow:/mlflow ghcr.io/mlflow/mlflow:v3.17.1 mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri sqlite:////mlflow/mlflow.db --artifacts-destination /mlflow/artifacts --allowed-hosts "localhost:5000,127.0.0.1:5000,host.docker.internal:5000"
# Depuis le conteneur de l'API : MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
